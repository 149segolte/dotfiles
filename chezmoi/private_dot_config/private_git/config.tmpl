[init]
    defaultBranch = main
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config" "git" "allowed_signers" }}
[commit]
    gpgsign = true
[tag]
    gpgSign = true
[user]
    name = {{ .modules.git.user.name }}
    email = {{ .modules.git.user.email }}
    signingkey = {{ joinPath .chezmoi.homeDir ".ssh" .modules.git.user.signingkey }}
